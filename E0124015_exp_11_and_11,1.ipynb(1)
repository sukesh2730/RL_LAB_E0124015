        "def epsilon_greedy_policy(state, epsilon):\n",
        "    if random.uniform(0,1) < epsilon:\n",
        "        return env.action_space.sample()\n",
        "    else:\n",
        "        return max(list(range(env.action_space.n)), key = lambda x: q[(state,x)])"
