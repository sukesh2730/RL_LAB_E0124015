        "def update_q_table(prev_state, action, reward, nextstate, alpha, gamma):\n",
        "\n",
        "    qa = max([q[(nextstate, a)] for a in range(env.action_space.n)])\n",
        "    q[(prev_state,action)] += alpha * (reward + gamma * qa - q[(prev_state,action)])"
      ],
